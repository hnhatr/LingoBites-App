{
  "name": "lingobites",
  "version": "0.0.1",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "android": "react-native run-android --mode developmentDebug",
    "ios": "cross-env ENVFILE=.env.development ruby ./node_modules/react-native-config/ios/ReactNativeConfig/BuildXCConfig.rb . ios/tmp.xcconfig && cp .env.development .env && cross-env ENVFILE=.env.development react-native run-ios --scheme Development --mode DebugDev --simulator \"iPhone 17\"",
    "lint": "eslint . && node scripts/check-module-boundaries.js && node scripts/check-eslint-warning-budget.js",
    "lint:boundaries": "node scripts/check-module-boundaries.js",
    "lint:budget": "node scripts/check-eslint-warning-budget.js",
    "lint:content": "node tools/content-lint/lint.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json}\"",
    "start": "react-native start",
    "test": "jest",
    "test:characterization:real-infra": "node scripts/characterization/inv002-sqlite-outbox-commit.mjs && jest --testPathPattern='inv002-(real-http-replay|sqlite-real-infra)\\.characterization'",
    "test:characterization:p2-real-infra": "jest --testPathPattern='p2-real-infra.*\\.matrix\\.characterization|realInfra/matrixManifest\\.test'",
    "test:characterization:m4-account-isolation": "jest --testPathPattern='m4-account-isolation.*\\.matrix\\.characterization|accountIsolation/matrixManifest\\.test'",
    "test:adversarial": "jest --testPathPattern='\\.adversarial\\.test'",
    "ios:dev": "cross-env ENVFILE=.env.development ruby ./node_modules/react-native-config/ios/ReactNativeConfig/BuildXCConfig.rb . ios/tmp.xcconfig && cp .env.development .env && cross-env ENVFILE=.env.development react-native run-ios --scheme Development --mode DebugDev --simulator \"iPhone 17 Pro\"",
    "ios:staging": "cross-env ENVFILE=.env.staging ruby ./node_modules/react-native-config/ios/ReactNativeConfig/BuildXCConfig.rb . ios/tmp.xcconfig && cp .env.staging .env && cross-env ENVFILE=.env.staging react-native run-ios --scheme Staging --mode DebugStag --simulator \"iPhone 17\"",
    "ios:production": "cross-env ENVFILE=.env.production ruby ./node_modules/react-native-config/ios/ReactNativeConfig/BuildXCConfig.rb . ios/tmp.xcconfig && cp .env.production .env && cross-env ENVFILE=.env.production react-native run-ios --scheme Production --mode DebugProd --simulator \"iPhone 17\"",
    "ios:build:staging": "scripts/ios-local-build.sh staging",
    "ios:build:production": "scripts/ios-local-build.sh production",
    "android:dev": "react-native run-android --mode developmentDebug",
    "android:staging": "react-native run-android --mode stagingDebug",
    "android:production": "react-native run-android --mode productionDebug",
    "android:build:staging": "scripts/android-local-build.sh staging",
    "android:build:production": "scripts/android-local-build.sh production",
    "pod": "bundle exec pod install --project-directory=ios",
    "pod:clean": "cd ios && pod deintegrate && rm -rf ~/Library/Caches/CocoaPods && rm -rf Pods && rm -rf ~/Library/Developer/Xcode/DerivedData/* && rm -rf Podfile.lock",
    "clean": "rm -rf node_modules && watchman watch-del-all",
    "clean:ios": "cd ios && xcodebuild clean && cd ../",
    "clean:android": "cd android && ./gradlew clean && cd ../",
    "open:ios": "xed -b ios",
    "open:android": "open -a '/Applications/Android Studio.app' android",
    "assets:link": "react-native-asset",
    "icons:subset": "node scripts/subset-material-icons.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@dr.pogodin/react-native-fs": "^2.40.2",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.2",
    "@react-native/new-app-screen": "0.85.3",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.85.3",
    "react-native-audio-recorder-player": "3.6.12",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-permissions": "^5.6.1",
    "react-native-quick-sqlite": "^8.2.7",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.25.2",
    "react-native-sound": "^0.13.0",
    "react-native-svg": "^15.15.0",
    "react-native-tts": "4.1.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.12.0",
    "react-native-youtube-iframe": "^2.4.1",
    "uuid": "^14.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@react-native-community/cli": "20.1.3",
    "@react-native-community/cli-platform-android": "20.1.3",
    "@react-native-community/cli-platform-ios": "20.1.3",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "@types/uuid": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.19.0",
    "eslint-plugin-react-native-a11y": "3.5.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "subset-font": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
