require "base64"
require "open3"
require "plist"
require "shellwords"
require "tempfile"
require_relative "signing_config"

IOS_XCODEPROJ = "ios/LingoBites.xcodeproj"
IOS_WORKSPACE = "ios/LingoBites.xcworkspace"
IPA_OUTPUT_PREFIX = "LingoBites"

def mobile_project_root
  File.expand_path("..", __dir__)
end

def read_env_value(envfile, key)
  path = File.join(mobile_project_root, envfile)
  UI.user_error!("Env file not found: #{path}") unless File.exist?(path)

  File.foreach(path) do |line|
    stripped = line.strip
    next if stripped.empty? || stripped.start_with?("#")

    name, value = stripped.split("=", 2)
    next unless name == key

    return value.to_s.strip
  end

  UI.user_error!("Missing #{key} in #{envfile}")
end

default_platform(:ios)

platform :ios do
  before_all do
    if ENV["CI"]
      setup_ci

      certificate_options = SigningConfig.certificate_import_options(ENV)
      import_certificate(
        certificate_path: certificate_options[:certificate_path],
        certificate_password: certificate_options[:certificate_password],
        keychain_name: certificate_options[:keychain_name],
        keychain_password: certificate_options[:keychain_password],
        log_output: false
      )
    end
  end

  desc "Build and upload the Staging app to TestFlight"
  lane :staging do
    envfile = ".env.staging"
    build_for_testflight(
      app_identifier: read_env_value(envfile, "IOS_BUNDLE_ID"),
      scheme: "Staging",
      configuration: "ReleaseStag",
      envfile: envfile
    )
  end

  desc "Build and upload the Production app to TestFlight"
  lane :production do
    envfile = ".env.production"
    build_for_testflight(
      app_identifier: read_env_value(envfile, "IOS_BUNDLE_ID"),
      scheme: "Production",
      configuration: "ReleaseProd",
      envfile: envfile
    )
  end

  private_lane :build_for_testflight do |options|
    key_id = ENV.fetch("APP_STORE_CONNECT_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID")
    api_key_content = ENV.fetch("APP_STORE_CONNECT_API_KEY")
    development_team = ENV.fetch("IOS_DEVELOPMENT_TEAM")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: api_key_content,
      is_key_content_base64: true,
      in_house: false
    )

    ENV["APP_IDENTIFIER"] = options[:app_identifier]
    ENV["ENVFILE"] = options[:envfile]

    project_root = mobile_project_root
    hermes_cli_path = [
      File.join(project_root, "ios/Pods/hermes-engine/destroot/bin/hermesc"),
      File.join(project_root, "node_modules/hermes-compiler/hermesc/osx-bin/hermesc")
    ].find { |path| File.exist?(path) }

    if hermes_cli_path
      ENV["HERMES_CLI_PATH"] = hermes_cli_path
    else
      ENV.delete("HERMES_CLI_PATH")
    end

    ENV.delete("APP_STORE_CONNECT_API_KEY")

    # Passed as a build setting (not agvtool/increment_build_number) so ios/ sources stay
    # untouched and the expo-updates fingerprint matches the one `eas update` computes.
    # Defaults to the latest TestFlight build number + 1; IOS_APP_BUILD_NUMBER overrides it.
    build_number = ENV["IOS_APP_BUILD_NUMBER"].to_s.strip
    if build_number.empty?
      latest_build_number = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: options[:app_identifier],
        initial_build_number: 0
      )
      build_number = (latest_build_number.to_i + 1).to_s
    end
    UI.message("Using iOS build number #{build_number}")

    Tempfile.create(["AuthKey_#{key_id}", ".p8"]) do |key_file|
      key_file.write(Base64.decode64(api_key_content))
      key_file.flush
      File.chmod(0o600, key_file.path)

      profile_path = ENV["IOS_PROVISIONING_PROFILE_PATH"]
      profile_name = SigningConfig.optional_env_value(ENV, "IOS_PROVISIONING_PROFILE_SPECIFIER")

      if profile_path && !profile_path.empty?
        UI.user_error!("Provisioning profile not found: #{profile_path}") unless File.exist?(profile_path)

        install_provisioning_profile(path: profile_path)

        decoded_profile, profile_status = Open3.capture2("security", "cms", "-D", "-i", profile_path)
        UI.user_error!("Unable to read provisioning profile: #{profile_path}") unless profile_status.success?

        profile = Plist.parse_xml(decoded_profile)
        profile_name = SigningConfig.validate_profile!(
          profile,
          app_identifier: options[:app_identifier],
          development_team: development_team
        )
      end

      store_profile_name = profile_name || "iOS Team Store Provisioning Profile: #{options[:app_identifier]}"
      signing_style = profile_name ? "manual" : "automatic"

      provisioning_xcargs = [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{Shellwords.escape(key_file.path)}",
        "-authenticationKeyID #{Shellwords.escape(key_id)}",
        "-authenticationKeyIssuerID #{Shellwords.escape(issuer_id)}"
      ].join(" ")

      signing_xcargs = SigningConfig.archive_signing_settings(
        profile_name: profile_name,
        development_team: development_team
      ).map do |name, value|
        "#{name}=#{Shellwords.escape(value)}"
      end

      build_number_xcargs = "CURRENT_PROJECT_VERSION=#{Shellwords.escape(build_number)}"
      # The index store only serves Xcode's editor features; skip it in the archive.
      archive_xcargs = ([provisioning_xcargs, build_number_xcargs, "COMPILER_INDEX_STORE_ENABLE=NO"] + signing_xcargs).join(" ")

      build_app(
        workspace: IOS_WORKSPACE,
        scheme: options[:scheme],
        configuration: options[:configuration],
        clean: true,
        export_method: "app-store",
        export_team_id: development_team,
        export_options: {
          method: "app-store-connect",
          teamID: development_team,
          signingStyle: signing_style,
          signingCertificate: "Apple Distribution",
          provisioningProfiles: {
            options[:app_identifier] => store_profile_name
          }
        },
        xcargs: archive_xcargs,
        output_directory: "build/ios",
        output_name: "#{IPA_OUTPUT_PREFIX}-#{options[:scheme]}.ipa"
      )
    end

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end

platform :android do
  desc "Build Staging AAB and upload it to Google Play"
  lane :staging do
    envfile = ".env.staging"
    build_android_for_play(
      package_name: read_env_value(envfile, "ANDROID_BUNDLE_ID"),
      build_type: "stagingRelease",
      envfile: envfile
    )
  end

  desc "Build Production AAB and upload it to Google Play"
  lane :production do
    envfile = ".env.production"
    build_android_for_play(
      package_name: read_env_value(envfile, "ANDROID_BUNDLE_ID"),
      build_type: "productionRelease",
      envfile: envfile
    )
  end

  # Highest version code on any Google Play track + 1, never lower than
  # ANDROID_APP_VERSION_CODE from the env file. ANDROID_VERSION_CODE overrides it.
  private_lane :next_android_version_code do |options|
    override = ENV["ANDROID_VERSION_CODE"].to_s.strip
    next override.to_i unless override.empty?

    failed_tracks = []
    play_version_codes = %w[internal alpha beta production].flat_map do |track|
      google_play_track_version_codes(
        package_name: options[:package_name],
        track: track,
        json_key: options[:json_key]
      )
    rescue StandardError => e
      UI.important("Could not read version codes for track '#{track}': #{e.message}")
      failed_tracks << track
      []
    end
    UI.user_error!("Could not read version codes from any Google Play track") if failed_tracks.size == 4

    env_version_code = read_env_value(options[:envfile], "ANDROID_APP_VERSION_CODE").to_i
    [play_version_codes.max.to_i + 1, env_version_code].max
  end

  private_lane :build_android_for_play do |options|
    ENV["ENVFILE"] = options[:envfile]
    json_key = ENV.fetch("PLAY_STORE_JSON_KEY_FILE")

    version_code = next_android_version_code(
      package_name: options[:package_name],
      json_key: json_key,
      envfile: options[:envfile]
    )
    UI.message("Using Android versionCode #{version_code}")
    # Play builds ship ARM only: x86/x86_64 are for emulators and would double the
    # native (C++) compile time. No `clean` task: CI always starts from a fresh checkout.
    gradle_properties = {
      "lingobitesVersionCode" => version_code,
      "reactNativeArchitectures" => "armeabi-v7a,arm64-v8a"
    }

    # On CI, skip Android lint vital: ~2 min on the critical path of every release build.
    lint_vital_task = "lintVital#{options[:build_type][0].upcase}#{options[:build_type][1..]}"

    gradle(
      task: "bundle",
      build_type: options[:build_type],
      project_dir: "android",
      properties: gradle_properties,
      flags: ENV["CI"] ? "-x #{lint_vital_task}" : nil
    )

    aab_path = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]

    upload_to_play_store(
      package_name: options[:package_name],
      track: ENV.fetch("PLAY_STORE_TRACK", "internal"),
      release_status: ENV.fetch("PLAY_STORE_RELEASE_STATUS", "completed"),
      json_key: json_key,
      aab: aab_path,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
