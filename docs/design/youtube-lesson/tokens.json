{
  "description": "Map biến CSS trong screens/*.html và canvas/*.dc.html sang key theme trong src/ui/theme. Light = themes/default.ts ('Sáng'), dark = themes/dark.ts ('Tối').",
  "themeFiles": {
    "light": "src/ui/theme/themes/default.ts",
    "dark": "src/ui/theme/themes/dark.ts"
  },
  "colors": {
    "--background": {
      "theme": "colors.background",
      "light": "#fcfae6",
      "dark": "#0b1120"
    },
    "--surface": {
      "theme": "colors.surface",
      "light": "#ffffff",
      "dark": "#1e293b"
    },
    "--surfaceLow": {
      "theme": "colors.surfaceLow",
      "light": "#f6f4e1",
      "dark": "#0f172a"
    },
    "--surfaceContainer": {
      "theme": "colors.surfaceContainer",
      "light": "#f0efdb",
      "dark": "#1e293b"
    },
    "--surfaceHigh": {
      "theme": "colors.surfaceHigh",
      "light": "#ebe9d5",
      "dark": "#334155"
    },
    "--outlineVariant": {
      "theme": "colors.outlineVariant",
      "light": "#bacac5",
      "dark": "#94a3b8"
    },
    "--outline": {
      "theme": "colors.outline",
      "light": "#6b7a76",
      "dark": "#94a3b8"
    },
    "--primary": {
      "theme": "colors.primary",
      "light": "#006b5f",
      "dark": "#93c5fd"
    },
    "--onPrimary": {
      "theme": "components.button.primary.text",
      "light": "#ffffff",
      "dark": "#0b1120",
      "note": "Chữ trên nền --primary. Theme chưa có colors.onPrimary riêng."
    },
    "--primaryContainer": {
      "theme": "colors.primaryContainer",
      "light": "#2dd4bf",
      "dark": "#2563eb"
    },
    "--onPrimaryContainer": {
      "theme": "colors.onPrimaryContainer",
      "light": "#00574d",
      "dark": "#dbeafe"
    },
    "--accentSoft": {
      "theme": "colors.accentSoft",
      "light": "#ddf8f5",
      "dark": "#1f4458"
    },
    "--secondarySoft": {
      "theme": "colors.secondarySoft",
      "light": "rgba(254,116,136,0.16)",
      "dark": "rgba(248,113,113,0.18)"
    },
    "--favorite": {
      "theme": "colors.secondary (light) / ĐỀ XUẤT token mới (dark)",
      "light": "#a93349",
      "dark": "#fca5a5",
      "note": "Màu nút ♥ lưu câu. Ở theme Tối, colors.secondary là #94a3b8 (xám) nên không dùng được cho ♥; cần thêm token hoặc dùng giá trị này."
    },
    "--tertiary": {
      "theme": "colors.tertiary",
      "light": "#6d5e00",
      "dark": "#fcd34d"
    },
    "--tertiarySoft": {
      "theme": "colors.tertiarySoft",
      "light": "rgba(255,226,76,0.22)",
      "dark": "rgba(252,211,77,0.18)"
    },
    "--danger": {
      "theme": "colors.danger",
      "light": "#ba1a1a",
      "dark": "#f87171"
    },
    "--text-primary": {
      "theme": "colors.text.primary",
      "light": "#1c1c10",
      "dark": "#f8fafc"
    },
    "--text-secondary": {
      "theme": "colors.text.secondary",
      "light": "#3c4a46",
      "dark": "#cbd5e1"
    },
    "--text-muted": {
      "theme": "colors.text.muted",
      "light": "#5f6e6a",
      "dark": "#94a3b8"
    },
    "--shadow": {
      "theme": "shadow.soft",
      "light": "0 4px 20px rgba(20,28,50,.06)",
      "dark": "none"
    }
  },
  "fixedColors": {
    "#000000 / #1c1c10": "Nền khung video và thumbnail, giữ tối ở cả hai theme.",
    "rgba(0,0,0,.4)": "Lớp phủ sau bottom sheet, tương ứng colors.overlay (0.55) nhưng nhẹ hơn để video vẫn thấy rõ."
  },
  "radius": {
    "18": "radius.md / components.input.radius (ô nhập, thẻ nhỏ)",
    "24": "radius.lg / components.card.radius / components.button.*.radius",
    "32": "radius.xl (góc trên bottom sheet)",
    "999": "radius.pill (chip)"
  },
  "spacing": {
    "16": "gutter (lề hai bên màn)",
    "4 / 8 / 12 / 16 / 24": "spacing.xs / sm / md / lg / xl"
  },
  "sizes": {
    "buttonHeight": {"value": 52, "theme": "components.button.primary.height"},
    "iconButton": {"value": 44, "note": "Vùng chạm tối thiểu 44×44"},
    "screen": {"width": 390, "height": 844}
  },
  "typography": {
    "fontFamily": "Font hệ thống (theme default không đặt fontFamily)",
    "icons": "Material Symbols Rounded (MaterialIcon trong app); class .ms = outline, .ms.f = filled",
    "scale": {
      "26/32 700": "Tiêu đề màn hoàn thành",
      "22/28 600": "typographyPresets.h2",
      "21/29 600": "Câu tiếng Anh trên thẻ câu",
      "18/24 600": "typographyPresets.h3 (tiêu đề header, sheet)",
      "16/23": "Bản dịch tiếng Việt",
      "15/22": "Nội dung phụ",
      "13–14": "Caption, nhãn"
    }
  }
}
