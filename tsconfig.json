{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "resolveJsonModule": true,
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@app": ["src/app"],
      "@app/*": ["src/app/*"],
      "@features": ["src/features"],
      "@features/*": ["src/features/*"],
      "@ui": ["src/ui"],
      "@ui/*": ["src/ui/*"],
      "@core": ["src/core"],
      "@core/*": ["src/core/*"],
      "@test": ["src/test"],
      "@test/*": ["src/test/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.json"],
  "exclude": ["**/node_modules", "**/Pods"]
}
